    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "url": "/messages",
      "icons": [{ "src": "/vaani-icon.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Connect",
      "short_name": "Connect",
      "url": "/connect",
      "icons": [{ "src": "/vaani-icon.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
